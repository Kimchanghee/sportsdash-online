---
import Base from './Base.astro';
import { koDate } from '../lib/content';
interface Props { title: string; h1: string; description: string; path: string; kicker: string; updated: string; ld?: Record<string, unknown>[] }
const { title, h1, description, path, kicker, updated, ld = [] } = Astro.props;
const crumbs = [{ name: '홈', href: '/' }, { name: h1, href: path }];
---
<Base title={title} description={description} path={path} crumbs={crumbs} jsonld={ld}>
  <div class="wrap">
    <article class="text-page">
      <p class="eyebrow">{kicker}</p>
      <h1 class="page-title">{h1}</h1>
      <p class="byline">최종 수정 <time datetime={updated}>{koDate(updated)}</time></p>
      <slot />
      <p style="margin-top:2em"><a href="/">홈</a> · <a href="/guides/">체크리스트</a> · <a href="/about/">소개</a></p>
    </article>
  </div>
</Base>
