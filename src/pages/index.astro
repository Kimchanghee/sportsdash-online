---
import Base from '../layouts/Base.astro';
import { allGuides, allPosts, guidePath, postPath, ymd } from '../lib/content';
import { site, categoryBySlug } from '../site.config';

const guides = await allGuides();
const posts = await allPosts();
const latest = guides.slice(0, 6);
const title = '스포츠대시 | 운동 장비 사기 전 체크리스트와 구매 가이드';
const description = '덤벨·요가매트·러닝화·텐트·침낭·등산 배낭을 사기 전에 확인할 항목을 체크리스트로 정리했습니다. 사양은 제조사·공식 자료 기준이고, 제휴 링크가 있는 글은 맨 위에 표시합니다.';
const ld = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: site.url + '/',
  hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.data.title, url: site.url + guidePath(g.data.slug) })),
}];
---
<Base title={title} description={description} path="/" jsonld={ld}>
  <div class="wrap">
    <section class="today" aria-labelledby="today-h">
      <div>
        <p class="log-kicker">TODAY'S SHEET</p>
        <h1 id="today-h" class="log-title">운동 장비, 사기 전에 이 항목부터 체크하세요</h1>
        <p class="lede">스포츠대시는 홈트·러닝·캠핑·아웃도어 장비를 고를 때 확인할 사양과 실수를 체크리스트로 남기는 구매 일지입니다. 지금 사려는 장비의 분류를 고르면 해당 체크리스트로 바로 이동합니다.</p>
      </div>
      <nav aria-label="장비 분류">
        <ul class="cat-sheet">
          {site.categories.map((c) => (
            <li><a href={`/category/${c.slug}/`}><span class="code">{c.code}</span><span><strong>{c.name}</strong><span class="blurb">{c.blurb}</span></span><span class="count">{guides.filter((g) => g.data.category === c.slug).length} LOG</span></a></li>
          ))}
        </ul>
      </nav>
    </section>

    <section class="section" aria-labelledby="log-h">
      <div class="section__head"><h2 id="log-h">최근 업데이트된 체크리스트</h2><p>{guides.length} entries</p></div>
      <table class="logtable">
        <thead><tr><th scope="col">분류</th><th scope="col">질문</th><th scope="col">항목</th><th scope="col">수정일</th></tr></thead>
        <tbody>
          {latest.map((g) => (
            <tr>
              <td class="code">{categoryBySlug(g.data.category)?.code}</td>
              <td><a href={guidePath(g.data.slug)}>{g.data.title}</a><span class="sub">{g.data.question}</span></td>
              <td class="num">{g.data.checklist.length}개 항목</td>
              <td class="date"><time datetime={g.data.updated}>{ymd(g.data.updated)}</time></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p><a href="/guides/">체크리스트 전체 {guides.length}개 보기</a></p>
    </section>

    <section class="section" aria-labelledby="picks-h">
      <div class="section__head"><h2 id="picks-h">장비 추천 글</h2><p>{posts.length} picks</p></div>
      {posts.length === 0 ? (
        <p class="empty">아직 발행된 상품 추천 글이 없습니다. 추천 글은 판매 링크가 실제 상품·옵션으로 연결되는지 확인한 뒤에만 올립니다. 그동안은 위 체크리스트로 직접 비교해 보세요.</p>
      ) : (
        <table class="logtable">
          <thead><tr><th scope="col">분류</th><th scope="col">글</th><th scope="col">발행</th></tr></thead>
          <tbody>{posts.slice(0, 8).map((p) => (
            <tr><td class="code">{categoryBySlug(p.data.category)?.code}</td><td><a href={postPath(p.data.slug)}>{p.data.title}</a><span class="sub">{p.data.product.name}</span></td><td class="date">{ymd(p.data.published)}</td></tr>
          ))}</tbody>
        </table>
      )}
    </section>

    <section class="section" aria-labelledby="how-h">
      <div class="section__head"><h2 id="how-h">이 사이트가 장비를 다루는 방식</h2><p>method</p></div>
      <p class="lede" style="margin-top:14px">사양은 제조사 상세페이지나 공식 기관 자료에서만 옮기고, 써 보지 않은 제품을 써 본 것처럼 쓰지 않습니다. 자세한 기준은 <a href="/methodology/">상품 선정 방법</a>과 <a href="/about/">편집 원칙</a>에 적어 두었습니다.</p>
    </section>
  </div>
</Base>
