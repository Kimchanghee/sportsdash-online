---
import Base from '../layouts/Base.astro';
import { allGuides, allPosts, guidePath, postPath, koDate, isPhoto } from '../lib/content';
import { site, categoryBySlug } from '../site.config';

const guides = await allGuides();
const posts = await allPosts();
const latest = guides.slice(0, 6);
const order = ['camping', 'outdoor', 'running', 'home-training'];
const cats = order.map((s) => site.categories.find((c) => c.slug === s)!).filter(Boolean);
const thumbOf = (p: (typeof posts)[number]) => p.data.images.find((i) => isPhoto(i.src))?.src ?? p.data.images[0]?.src;
const title = '스포츠대시 | 운동 장비 사기 전 체크리스트와 구매 가이드';
const description = '덤벨·요가매트·러닝화·텐트·침낭·등산 배낭을 사기 전에 확인할 항목을 체크리스트로 정리했습니다. 사양은 제조사·공식 자료 기준이고, 제휴 링크가 있는 글은 맨 위에 표시합니다.';
const ld = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: site.url + '/',
  hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.data.title, url: site.url + guidePath(g.data.slug) })),
}];
---
<Base title={title} description={description} path="/" jsonld={ld}>
  <div class="wrap">
    <section class="intro" aria-labelledby="intro-h">
      <p class="eyebrow">운동·캠핑 장비 구매 가이드</p>
      <h1 id="intro-h" class="page-title">장비를 사기 전에, 확인할 것부터</h1>
      <p class="lede">스포츠대시는 캠핑·등산·러닝·홈트레이닝 장비를 고를 때 확인할 사양과 흔한 실수를 정리합니다. 사양은 제조사·공식 자료로만 적고, 써 보지 않은 제품을 써 본 것처럼 쓰지 않습니다.</p>
      <ul class="trail-cats">
        {cats.map((c) => (
          <li><a href={`/category/${c.slug}/`}><strong>{c.navLabel ?? c.name}</strong><span class="count">체크리스트 {guides.filter((g) => g.data.category === c.slug).length}개</span><span class="blurb">{c.blurb}</span></a></li>
        ))}
      </ul>
    </section>

    <div class="home-grid">
      <section class="section" aria-labelledby="picks-h">
        <div class="section-head"><h2 id="picks-h">장비 추천 글</h2><p>{posts.length}편</p></div>
        {posts.length === 0 ? (
          <p class="empty">아직 발행된 상품 추천 글이 없습니다. 추천 글은 판매 링크가 실제 상품·옵션으로 연결되는지 확인한 뒤에만 올립니다.</p>
        ) : (
          <ul class="pick-list">{posts.slice(0, 8).map((p) => (
            <li><a href={postPath(p.data.slug)}>{thumbOf(p) ? <img src={thumbOf(p)} alt="" width="160" height="120" loading="lazy" decoding="async" /> : <span />}<span><strong>{p.data.title}</strong><span>{categoryBySlug(p.data.category)?.navLabel ?? categoryBySlug(p.data.category)?.name} · {koDate(p.data.published)}</span></span></a></li>
          ))}</ul>
        )}
        <p><a href="/picks/">추천 글 전체 보기</a></p>
      </section>

      <section class="section" aria-labelledby="log-h">
        <div class="section-head"><h2 id="log-h">최근 업데이트된 체크리스트</h2><p>{guides.length}개</p></div>
        <ul class="guide-list">
          {latest.map((g) => (
            <li><a href={guidePath(g.data.slug)}><strong>{g.data.title}</strong><span>{g.data.question}</span><span class="when">{categoryBySlug(g.data.category)?.navLabel ?? categoryBySlug(g.data.category)?.name} · 점검 항목 {g.data.checklist.length}개 · <time datetime={g.data.updated}>{koDate(g.data.updated)}</time> 수정</span></a></li>
          ))}
        </ul>
        <p><a href="/guides/">체크리스트 전체 {guides.length}개 보기</a></p>
      </section>
    </div>

    <section class="section method" aria-labelledby="how-h">
      <h2 id="how-h" class="sr-h">이 사이트가 장비를 다루는 방식</h2>
      <p>사양은 제조사 상세페이지나 공식 기관 자료에서만 옮기고, 두 자료가 다르면 그 항목은 빼고 씁니다. 자세한 기준은 <a href="/methodology/">상품 선정 방법</a>과 <a href="/about/">편집 원칙</a>에 적어 두었습니다.</p>
    </section>
  </div>
</Base>
