---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { allPosts, allGuides, postPath, guidePath, articleLd, faqLd, ymd, koDate, isPhoto, disclosureFor, type Post } from '../../lib/content';
import { categoryBySlug, providerInfo, site } from '../../site.config';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((p) => ({ params: { slug: p.data.slug }, props: { post: p } }));
}
interface Props { post: Post }
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const cat = categoryBySlug(d.category)!;
const path = postPath(d.slug);
const cover = d.images.find((i) => i.role === 'cover') ?? d.images[0];
const coverIsPhoto = isPhoto(cover.src);
const thumb = coverIsPhoto ? cover.src : d.images.find((i) => isPhoto(i.src))?.src;
const og = `/og/picks/${d.slug}.png`;
const guides = (await allGuides()).filter((g) => g.data.category === d.category).slice(0, 3);
const prov = providerInfo(d.product.provider);
const ld = [articleLd('post', post, path, og), faqLd(d.faq)].filter(Boolean) as Record<string, unknown>[];
const crumbs = [ { name: '홈', href: '/' }, { name: cat.name, href: `/category/${cat.slug}/` }, { name: d.title, href: path, short: d.primaryKeyword } ];
const edited = ymd(d.updated) !== ymd(d.published);
const arrow = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 4l6 6-6 6"/></svg>';
---
<Base title={`${d.title} | ${site.name}`} description={d.description} path={path} ogImage={og} ogType="article" jsonld={ld} crumbs={crumbs} published={d.published} updated={d.updated} navCurrent={`/category/${cat.slug}/`}>
  <div class="wrap">
    <article class="post" data-gate="article">
      <p class="disclosure" data-gate="disclosure"><strong>제휴 고지</strong>{disclosureFor(post)}</p>
      <header class="post-head">
        <h1>{d.title}</h1>
        <p class="byline">
          <span class="tag">{cat.navLabel ?? cat.name}</span>
          <span><time datetime={d.published}>{koDate(d.published)}</time> 작성</span>
          {edited && <span><time datetime={d.updated}>{koDate(d.updated)}</time> 수정</span>}
          <span>사양: 제조사·판매 페이지 기준</span>
        </p>
      </header>
      <figure class={coverIsPhoto ? 'hero' : 'hero hero--diagram'}>
        <img src={cover.src} alt={cover.alt} width={coverIsPhoto ? 1280 : 1080} height={coverIsPhoto ? 853 : 1350} loading="eager" fetchpriority="high" decoding="async" />
      </figure>
      <div class="answer-box">
        <p class="answer-box__label">먼저 답부터</p>
        <p class="answer" data-gate="answer">{d.answer}</p>
      </div>
      <ProductCard product={d.product} variant="inline" thumb={thumb} />
      <div class="after-hero">
        <div class="prose" data-gate="body"><Content /></div>
        {d.faq.length > 0 && (
          <section class="faq" data-gate="faq" aria-labelledby="faq-h">
            <h2 id="faq-h">자주 묻는 질문</h2>
            {d.faq.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
          </section>
        )}
        <section class="endcta" aria-label="판매 페이지 확인">
          <p class="t">{d.product.name}</p>
          <p class="s">옵션: {d.product.optionDetail} · 가격·재고·배송 조건은 판매 페이지에서 마지막으로 확인하세요. ({prov.name} 제휴 링크)</p>
          <a class="btn" href={d.product.url} rel="sponsored nofollow noopener" target="_blank" data-product-link="end">판매 페이지 열기<Fragment set:html={arrow} /></a>
        </section>
        <AdSlot id="pick-end" />
        <section class="sources" data-gate="sources">
          <h2>출처</h2>
          <ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}</ul>
          <p>링크 확인 {koDate(d.product.verifiedAt)} · 마지막 수정 <time datetime={d.updated}>{koDate(d.updated)}</time></p>
        </section>
        <nav class="related" aria-labelledby="rel-h">
          <h2 id="rel-h">고르기 전에 볼 체크리스트</h2>
          <ul>{guides.map((g) => <li><a href={guidePath(g.data.slug)}>{g.data.title}</a></li>)}</ul>
          <p><a href={`/category/${cat.slug}/`}>{cat.name} 전체 보기</a> · <a href="/methodology/">상품 선정 방법</a></p>
        </nav>
      </div>
      <aside class="side" aria-label="상품 카드">
        <div class="side__sticky"><ProductCard product={d.product} variant="side" thumb={thumb} /></div>
      </aside>
    </article>
  </div>
</Base>
