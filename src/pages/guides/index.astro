---
import Base from '../../layouts/Base.astro';
import { allGuides, guidePath, koDate } from '../../lib/content';
import { site, categoryBySlug } from '../../site.config';
const guides = await allGuides();
const title = '운동 장비 구매 체크리스트 전체 목록 | 스포츠대시';
const description = '홈트레이닝, 러닝, 캠핑, 아웃도어 장비를 고를 때 확인할 사양과 흔한 실수를 정리한 체크리스트 전체 목록입니다. 각 글은 공식 자료 출처와 수정일을 함께 적습니다.';
const crumbs = [{ name: '홈', href: '/' }, { name: '구매 체크리스트', href: '/guides/' }];
const order = ['camping', 'outdoor', 'running', 'home-training'];
const ld = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: site.url + '/guides/', description }];
---
<Base title={title} description={description} path="/guides/" jsonld={ld} crumbs={crumbs} ogImage="/og/guides.png">
  <div class="wrap">
    <section class="intro">
      <p class="eyebrow">전체 목록</p>
      <h1 class="page-title">운동 장비 구매 체크리스트</h1>
      <p class="lede">각 체크리스트는 하나의 구매 질문에 답합니다. 분류별로 모았고, 글마다 공식 자료 출처와 수정일을 함께 적습니다.</p>
    </section>
    {order.map((s) => {
      const c = categoryBySlug(s)!;
      const list = guides.filter((g) => g.data.category === s);
      return list.length > 0 && (
        <section class="section">
          <div class="section-head"><h2>{c.navLabel ?? c.name}</h2><p>{list.length}개</p></div>
          <ul class="guide-list">{list.map((g) => (
            <li><a href={guidePath(g.data.slug)}><strong>{g.data.title}</strong><span>{g.data.description}</span><span class="when">점검 항목 {g.data.checklist.length}개 · <time datetime={g.data.updated}>{koDate(g.data.updated)}</time> 수정</span></a></li>
          ))}</ul>
        </section>
      );
    })}
    <p><a href="/">홈으로</a> · <a href="/methodology/">상품 선정 방법</a></p>
  </div>
</Base>
