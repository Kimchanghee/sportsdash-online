---
import Base from '../../layouts/Base.astro';
import { allGuides, allPosts, guidePath, postPath, koDate, isPhoto } from '../../lib/content';
import { site } from '../../site.config';

export async function getStaticPaths() {
  return (await import('../../data/site.json')).default.categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
interface Props { cat: { slug: string; name: string; navLabel?: string; code: string; blurb: string; answer: string } }
const { cat } = Astro.props;
const guides = (await allGuides()).filter((g) => g.data.category === cat.slug);
const posts = (await allPosts()).filter((p) => p.data.category === cat.slug);
const path = `/category/${cat.slug}/`;
const lastUpdated = [...guides.map((g) => g.data.updated), ...posts.map((p) => p.data.updated)].sort().at(-1) ?? '';
const title = `${cat.name} 장비 고르는 법과 구매 체크리스트 | ${site.name}`;
const description = `${cat.blurb} ${cat.name} 체크리스트 ${guides.length}개와 링크를 확인한 장비 추천 글을 한곳에 모았습니다. 각 글에 출처와 수정일을 표시합니다.`;
const crumbs = [{ name: '홈', href: '/' }, { name: cat.name, href: path }];
const ld = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: site.url + path, description }];
---
<Base title={title} description={description} path={path} jsonld={ld} crumbs={crumbs} ogImage={`/og/category/${cat.slug}.png`}>
  <div class="wrap">
    <section class="intro">
      <p class="eyebrow">{cat.navLabel ?? cat.name}</p>
      <h1 class="page-title">{cat.name} 장비, 무엇부터 확인할까?</h1>
      <div class="answer-box"><p class="answer-box__label">먼저 답부터</p><p class="answer">{cat.answer}</p></div>
      {lastUpdated && <p class="byline"><span>최종 수정 <time datetime={lastUpdated}>{koDate(lastUpdated)}</time></span><span>체크리스트 {guides.length}개 · 추천 글 {posts.length}개</span></p>}
      <p class="lede">{cat.blurb} 아래 체크리스트를 먼저 보고, 상품 추천 글은 링크가 실제 옵션으로 연결되는지 확인된 것만 모았습니다.</p>
    </section>
    <div class="home-grid">
      <section class="section">
        <div class="section-head"><h2>체크리스트</h2><p>{guides.length}개</p></div>
        <ul class="guide-list">{guides.map((g) => (
          <li><a href={guidePath(g.data.slug)}><strong>{g.data.title}</strong><span>{g.data.answer}</span><span class="when"><time datetime={g.data.updated}>{koDate(g.data.updated)}</time> 수정</span></a></li>
        ))}</ul>
      </section>
      <section class="section">
        <div class="section-head"><h2>장비 추천 글</h2><p>{posts.length}편</p></div>
        {posts.length === 0 ? (
          <p class="empty">{cat.name} 분야 상품 추천 글은 아직 없습니다. 추천 글은 판매 링크와 옵션을 확인한 뒤에만 발행합니다.</p>
        ) : (
          <ul class="pick-list">{posts.map((p) => {
            const t = p.data.images.find((i) => isPhoto(i.src))?.src ?? p.data.images[0]?.src;
            return <li><a href={postPath(p.data.slug)}>{t ? <img src={t} alt="" width="160" height="120" loading="lazy" decoding="async" /> : <span />}<span><strong>{p.data.title}</strong><span>{p.data.product.name} · {koDate(p.data.published)}</span></span></a></li>;
          })}</ul>
        )}
      </section>
    </div>
    <p><a href="/guides/">전체 체크리스트</a> · <a href="/methodology/">상품 선정 방법</a></p>
  </div>
</Base>
